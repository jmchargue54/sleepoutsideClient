---
import Layout from '../layouts/Layout.astro';
const title = "Home";
---
<Layout title={title}>
  <script src = "../js/main.ts"></script>
  <div class="hero">
    <img
      src="/images/banner-sm.jpg"
      srcset="images/banner-sm.jpg 500w, images/banner.jpg"
      alt="image of a high mountain lake"
    />
    <div class="logo logo--square">
      <img src="/images/noun_Tent_2517.svg" alt="tent image for logo" />
      <div>Sleep<span class="highlight">Outside</span></div>
    </div>
  </div>
  <section class="mission">
    <p>We spend too much time these days indoors...sitting usually.</p>
    <p>No wonder we are a mess!</p>
    <p>
      What we really need is to get outside...in fact SLEEP outside. Our
      mission is to provide you with everything you need to do this
      comfortably at an affordable price.
    </p>
  </section>

  <section class="gallery">
    <a href="product-list/index.html?category=tents"><img src="/images/svg/tent_icon.svg" alt="Tent Icon from Noun Project: Mustofa Bayu"> Tents</a>
    <a href="product-list/index.html?category=sleeping-bags"><img src="/images/svg/noun_Sleeping_Bag.svg" alt="Sleeping Bag Icon from Noun Project: Mustofa Bayu"> Sleeping Bags</a>        
    <a href="product-list/index.html?category=backpacks"><img src="/images/svg/noun_Backpack.svg" alt="Backpack Icon from Noun Project: Mustofa Bayu"> Backsets</a>
    <a href="product-list/index.html?category=hammocks"><img src="/images/svg/noun_Hammock.svg" alt="Hammock Icon from Noun Project: Paul Richard"> Hammocks</a>        
  </section> 

  <section class="newsletter">
    <h2>Stay in the loop</h2>
    <p>Sign up for our newsletter to get discounts, new product alerts, and outdoor tips.</p>

    <form id="newsletter-form" class="newsletter__form" novalidate>
      <div class="newsletter__field">
        <label for="newsletter-name">Name</label>
        <input id="newsletter-name" name="name" type="text" placeholder="Your name" required />
      </div>

      <div class="newsletter__field">
        <label for="newsletter-email">Email</label>
        <input id="newsletter-email" name="email" type="email" placeholder="you@example.com" required />
      </div>

      <button type="submit">Sign up</button>

      <div class="newsletter__message" aria-live="polite"></div>
    </form>
  </section>
  <script type="module">
    import { initNewsletterSignup } from '/js/newsletter.js';

    document.addEventListener('DOMContentLoaded', () => {
      initNewsletterSignup();
    });
  </script>
</Layout>

<style>
  .gallery{
    display: flex;
    align-items: center;
    margin: 0 -200px 20px -200px;
    text-align: center;
  }
  .gallery a{
    width: 75%;
    padding: 10px;
  }

  .newsletter {
    padding: 2em 1em;
    text-align: center;
    background-color: rgba(240, 168, 104, 0.1);
    border: 1px solid rgba(240, 168, 104, 0.4);
    margin: 2em auto;
    max-width: 600px;
    border-radius: 8px;
  }

  .newsletter h2 {
    margin-top: 0;
  }

  .newsletter__form {
    display: grid;
    gap: 1em;
    margin-top: 1em;
  }

  .newsletter__field {
    text-align: left;
  }

  .newsletter__field label {
    display: block;
    font-size: 0.9em;
    margin-bottom: 0.25em;
  }

  .newsletter__field input {
    width: 100%;
    padding: 0.5em;
    border: 1px solid var(--light-grey);
    border-radius: 4px;
  }

  .newsletter__form button {
    padding: 0.75em 1.25em;
    background-color: var(--primary-color);
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1em;
  }

  .newsletter__form button:hover {
    opacity: 0.9;
  }

  .newsletter__message {
    height: 1.4em;
    font-size: 0.9em;
    color: var(--dark-grey);
  }

  .newsletter__message--success {
    color: green;
  }

  .newsletter__message--error {
    color: firebrick;
  }
</style>
